# תבנית מפתחות לסאמר. העתק ל-.env.summer ומלא:
#   cp .env.summer.example .env.summer    (PowerShell: Copy-Item .env.summer.example .env.summer)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_secret_...           # service_role key (קריאה/כתיבה של נתונים)
SUPABASE_DB_PASSWORD=                # אופציונלי — רק ליצירת טבלאות (DDL) ע"י סאמר
