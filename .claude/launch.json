{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "myword",
      "runtimeExecutable": "node",
      "runtimeArgs": [".claude/static-server.mjs"],
      "port": 8099,
      "autoPort": true
    },
    {
      "name": "mockup-react",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "myword-mockup-react"],
      "port": 5199
    },
    {
      "name": "WONDER LETER – Static Server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".", "--listen", "3000", "--no-clipboard"],
      "port": 3000
    },
    {
      "name": "MyWord.html – Direct Preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".", "--listen", "3001", "--no-clipboard"],
      "port": 3001
    }
  ],
  "autoVerify": false
}
